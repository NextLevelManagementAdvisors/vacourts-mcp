# vacourts-mcp service env — copy to /opt/vacourts-mcp/.env on the VPS (chmod 600)
MCP_TRANSPORT=http
HOST=127.0.0.1
PORT=3032
MCP_PATH=/mcp

# Public base URL. OAuth metadata, the /authorize|/token|/register endpoints, and the
# /auth/callback redirect are all derived from this — it MUST be the external https URL.
MCP_BASE_URL=https://vacourts.nlma.io

# Google OAuth client (Web application) — create at:
#   https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: https://vacourts.nlma.io/auth/callback
# Auth is OFF when GOOGLE_OAUTH_CLIENT_ID is empty; when set, the other three are required.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Comma-separated allowlist of Google emails permitted to connect. Completing a Google
# login is necessary but NOT sufficient — the verified email must be on this list (or
# its domain must be in ALLOWED_GOOGLE_DOMAINS below). At least one of the two is required.
ALLOWED_GOOGLE_EMAILS=forrest@nlma.io

# Comma-separated allowlist of email domains (no leading @) permitted to connect, e.g.
# ALLOWED_GOOGLE_DOMAINS=nlma.io
# ALLOWED_GOOGLE_DOMAINS=

# Both lists above are unioned with the org-wide approved-domains registry (status.nlma.io
# Domains card, seeded from the claude.ai org's verified domains), refreshed every TTL
# seconds on a background thread. Set AUTHORIZED_DOMAINS_URL= (empty) to disable.
# AUTHORIZED_DOMAINS_URL=https://status.nlma.io/domains.json
# AUTHORIZED_DOMAINS_TTL=300

# Fixes the JWT signing key (and the derived, disk-persisted OAuth-state directory under
# FASTMCP_HOME) across restarts and GOOGLE_OAUTH_CLIENT_SECRET rotations, so issued tokens
# survive `docker compose up -d --force-recreate`. Generate with: openssl rand -hex 32
# Optional — omitting it falls back to deriving the key from GOOGLE_OAUTH_CLIENT_SECRET.
# FASTMCP_SERVER_AUTH_GOOGLE_JWT_SIGNING_KEY=

# Escape hatch: set to 1 to serve HTTP with NO auth (local testing only — never on the VPS).
# ALLOW_UNAUTHENTICATED=1
